{
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--completion-style=detailed",
    "--header-insertion=never"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "files.associations": {
    "*.h": "c",
    "*.inc": "asm",
    "*.asm": "asm"
  },
  "editor.formatOnSave": true
}
